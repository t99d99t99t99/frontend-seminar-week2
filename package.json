{
  "name": "frontend-seminar-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "check:types": "tsc -b",
    "check:format": "biome ci .",
    "check:unused": "knip",
    "check-all": "yarn check:types && yarn check:format && yarn check:unused",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "knip": "^6.32.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
